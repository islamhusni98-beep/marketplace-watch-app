{
  "name": "marketplace-watch-app",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "build": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.mkdirSync('dist',{recursive:true});fs.cpSync('public','dist',{recursive:true});console.log('Build complete: public -> dist')\"",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run format && npm run lint && npm run type-check && npm run build && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  }
}
